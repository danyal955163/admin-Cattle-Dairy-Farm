NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Or use the legacy Supabase anon key name if that is what the shared project provides.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional, server-only role lookup. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
# Optional: set the default route after login
NEXT_PUBLIC_ADMIN_DEFAULT_ROUTE=/dashboard
